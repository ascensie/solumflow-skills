# Server only. None of these may ever start with NEXT_PUBLIC_.

# The SolumFlow address of your account, with no path (https://app.example.com).
SOLUMFLOW_URL=
# A server key (crms_...) with catalog:read, cart:write and orders:write.
SOLUMFLOW_API_KEY=
# The signing key the webhook answer showed once (upsert_api_webhook).
SOLUMFLOW_WEBHOOK_KEY=
# The address of this site, with no path (https://www.example.com).
SOLUMFLOW_SITE_URL=
